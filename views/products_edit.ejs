<div class="products">
  <h1>Edit Product</h1>
  <form method="post" action="/admin/products/<%= product._id %>?_method=PUT" enctype="multipart/form-data">
    <label>Name</label>
    <input type="text" name="name" value="<%= product.name %>" />
    <label>Description</label>
    <input type="text" name="description" value="<%= product.description || '' %>" />
    <label>Price</label>
    <input type="number" step="0.01" min="0" name="price" value="<%= product.price %>" />
    <label>Stock</label>
    <input type="number" min="0" name="stock" value="<%= product.stock %>" />
    <label>Replace Image</label>
    <input type="file" name="image" accept="image/png,image/jpeg" />
    <label>Category</label>
    <input type="text" name="category" value="<%= product.category || '' %>" />
    <label>Active</label>
    <select name="active">
      <option value="true" <%= product.active ? 'selected' : '' %>>Yes</option>
      <option value="false" <%= !product.active ? 'selected' : '' %>>No</option>
    </select>
    <button type="submit">Save</button>
  </form>
  </main>
</body>
</html>


