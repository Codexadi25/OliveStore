<div class="auth-page">
  <div class="auth-card">
        <div class="auth-header">
          <h1>Register</h1>
          <p class="small">Create your OliveStore account</p>
        </div>

        <% if (error) { %>
          <p class="error"><%= error %></p>
        <% } %>

        <form class="auth-form" method="post" action="/register">
          <div>
            <label for="name">Name</label>
            <input id="name" class="input" type="text" name="name" required autocomplete="name" />
          </div>

          <div>
            <label for="email">Email</label>
            <input id="email" class="input" type="email" name="email" required autocomplete="email" />
          </div>

          <div>
            <label for="phoneNumber">Phone Number</label>
            <input id="phoneNumber" class="input" type="text" name="phoneNumber" required autocomplete="tel" />
          </div>

          <div>
            <label for="password">Password</label>
            <input id="password" class="input" type="password" name="password" required autocomplete="new-password" />
          </div>

          <div class="actions">
            <div></div>
            <button class="btn btn-primary" type="submit">Create Account</button>
          </div>
        </form>

        <div class="separator"></div>
        <p class="small center mt-8">Already have an account? <a class="link" href="/">Login</a></p>
      </div>
    </main>
  </body>
</html>


