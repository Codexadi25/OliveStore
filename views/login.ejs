<div class="auth-page">
  <div class="auth-card">
        <div class="auth-header">
          <h1>Login</h1>
          <p class="small">Access your OliveStore account</p>
        </div>

        <% if (error) { %>
          <p class="error"><%= error %></p>
        <% } %>

        <form class="auth-form" method="post" action="/login">
          <div>
            <label for="email">Email</label>
            <input id="email" class="input" type="email" name="email" autocomplete="email" />
          </div>

          <div class="center small">or</div>

          <div>
            <label for="phoneNumber">Phone Number</label>
            <input id="phoneNumber" class="input" type="text" name="phoneNumber" autocomplete="tel" />
          </div>

          <div>
            <label for="password">Password</label>
            <input id="password" class="input" type="password" name="password" required autocomplete="current-password" />
          </div>

          <div class="actions">
            <a class="link" href="/forgot-password">Forgot?</a>
            <button class="btn btn-primary" type="submit">Login</button>
          </div>
        </form>

        <div class="separator"></div>
        <p class="small center mt-8">New here? <a class="link" href="/register">Register</a></p>
      </div>
    </main>
  </body>
</html>


