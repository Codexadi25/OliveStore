<div class="stores">
    <div class="page-header">
      <!-- <h1>Stores</h1> -->
      <div class="header-actions">
        <% if (user && (user.role === 'admin' || user.role === 'staff')) { %>
          <a href="/stores/new" class="btn btn-primary">
            <span class="fab-icon">+</span> Add Store
          </a>
        <% } %>
      </div>
    </div>
    
    <div class="search-filters card">
      <form method="get" action="/stores" class="search-form">
        <div class="form-group">
          <label for="search">Search Stores</label>
          <input 
            type="text" 
            id="search" 
            name="q" 
            value="<%= q || '' %>" 
            placeholder="Search by name or contact number..."
          />
        </div>
        <button type="submit" class="btn btn-primary">Search</button>
      </form>
    </div>
    <table border="1" cellpadding="6">
      <thead>
        <tr>
          <th>Name</th>
          <th>Owner</th>
          <th>Contact</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% (stores || []).forEach(function(store){ %>
          <tr>
            <td><%= store.storeName %></td>
            <td><%= store.ownerName || (store.onboardedBy && store.onboardedBy.name) || '-' %></td>
            <td><%= store.contactNumber %></td>
            <td><%= store.onboardingStatus %></td>
            <td>
              <a href="/stores/<%= store._id %>/edit">Edit</a>
              <form method="post" action="/stores/<%= store._id %>?_method=DELETE" style="display:inline">
                <button type="submit" onclick="return confirm('Delete store?')">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <div style="margin-top:12px">
      <% if (page > 1) { %>
        <a href="/stores?q=<%= encodeURIComponent(q || '') %>&page=<%= page - 1 %>&limit=<%= limit %>">Prev</a>
      <% } %>
      <span style="margin:0 8px">Page <%= page %></span>
      <% if (hasMore) { %>
        <a href="/stores?q=<%= encodeURIComponent(q || '') %>&page=<%= page + 1 %>&limit=<%= limit %>">Next</a>
      <% } %>
    </div>
  </main>
</body>
</html>


