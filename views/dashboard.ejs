<div class="dashboard">
    <div class="dashboard-header">
      <h1>Welcome, <%= user && user.name ? user.name : 'User' %></h1>
      <p class="welcome">Track your store's performance and manage orders.</p>
    </div>

    <section class="card-grid">
      <div class="card">
        <h3>Total Stores</h3>
        <p><%= stats && stats.totalStores || 0 %></p>
      </div>
      
      <div class="card">
        <h3>Approved Stores</h3>
        <p><%= stats && stats.approvedStores || 0 %></p>
      </div>
      
      <div class="card">
        <h3>Pending Onboarding</h3>
        <p><%= stats && stats.pendingStores || 0 %></p>
      </div>
      
      <div class="card">
        <h3>Products</h3>
        <p><%= stats && stats.totalProducts || 0 %></p>
      </div>
      
      <div class="card">
        <h3>Users</h3>
        <p><%= stats && stats.totalUsers || 0 %></p>
      </div>
      
      <div class="card">
        <h3>Staff</h3>
        <p><%= stats && stats.staffUsers || 0 %></p>
      </div>
      
      <div class="card">
        <h3>Orders</h3>
        <p><%= stats && stats.totalOrders || 0 %></p>
      </div>
      
      <div class="card">
        <h3>Live Orders</h3>
        <p><%= stats && stats.liveOrders || 0 %></p>
      </div>
    </section>
  </main>
</body>
</html>


